{
  // Type-checks the complete test suite, which the root config deliberately
  // excludes so build output stays scoped to `src`. Without this, a breaking
  // change to an internal interface type-checks clean while every test call
  // site is already wrong: vitest transpiles without checking types, so the
  // mistake only surfaces if a test happens to fail at runtime.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The root config pins rootDir to `src` for build output. Nothing is
    // emitted here and the program spans both src and tests.
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // Tests run under Node but exercise the HTTP app through fetch-style
    // globals (Request/Response/FormData). Without the DOM lib, `res.json()`
    // resolves to `unknown` and every assertion on a response body becomes an
    // error that says nothing about the code under test.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // A test that renders a Console component is still a test, and it
    // type-checks here like any other: the JSX transform and React's types are
    // what that needs, not an exclusion. The Console modules it imports come in
    // through the import.
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // `vite/client` supplies the `*.css` module declarations that Console page
    // files rely on for side-effect stylesheet imports. Tests import those
    // components transitively, so this program needs the same ambient types
    // the Console's own tsconfig already declares.
    "types": ["node", "vitest/globals", "react", "react-dom", "vite/client"]
  },
  "include": ["tests/**/*", "src/**/*", "scripts/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist"]
}
