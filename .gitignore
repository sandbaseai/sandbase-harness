dist/
# Runtime state written into a workspace. The root entry covers a runtime
# started in this checkout; the logs/data entries cover workspaces committed as
# examples, where the config file is tracked but everything the runtime
# generates beside it is not.
/.managed-agents/
**/.managed-agents/logs/
**/.managed-agents/data.db*
.managed-agents-dev/
/agents/
/skills/
*.tsbuildinfo
*.db
.env
.env.local
coverage/
playwright-report/
test-results/
.DS_Store
.kiro/
# Local reference material (cloned OSS projects) — not shipped
references/
# Operator's local working notes — private to this checkout
/local-notes/

